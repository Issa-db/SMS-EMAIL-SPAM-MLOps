DB_URL=sqlite:///src/db/emails.sqlite
TABLE_NAME=ham
MODEL_PATH=src/model/models/NB_db_v1.onnx
VECTORIZER_PATH=src/model/models/vectorizer.joblib
ARTIFACT_STORE_PATH=artifacts/bundles
MANIFEST_PATH=artifacts/latest_bundle.json
# Set this to an approved latest or versioned manifest to serve that bundle.
# INFERENCE_BUNDLE_MANIFEST=artifacts/latest_bundle.json
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000
RANDOM_STATE=42
TEST_SIZE=0.2
CROSS_VALIDATION_FOLDS=3
# Set a threshold only after defining an acceptance target for the use case.
# MINIMUM_ACCURACY=0.90
MLFLOW_TRACKING_ENABLED=false
# When enabled without a URI, MLflow stores runs in ./mlflow.db.
# MLFLOW_TRACKING_URI=sqlite:////absolute/path/to/mlflow.db
# DATASET_VERSION=stable-source-snapshot-id
# CODE_REVISION=git-commit-sha
MLFLOW_EXPERIMENT_NAME=model-builder
